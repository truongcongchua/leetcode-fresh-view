{
  "manifest_version": 3,
  "name": "LeetCode Fresh View",
  "version": "1.4.0",
  "description": "Hide Solved and difficulty badges beside LeetCode problem titles.",
  "permissions": [
    "storage"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "LeetCode Fresh View"
  },
  "content_scripts": [
    {
      "matches": [
        "https://leetcode.com/*"
      ],
      "css": [
        "content.css"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ]
}
